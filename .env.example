# Web server
PORT=18790
PUBLIC_URL=http://localhost:18790

# Admin web UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Data storage (mounted volume in Docker)
DATA_DIR=/data

# Downstream auth for /v1/* : clients send Authorization: Bearer <API_KEY>.
# Empty = open access (do NOT leave empty on public networks).
API_KEY=

# Upstream bailucode OpenAPI
UPSTREAM_BASE=https://bailucode.com/openapi/v1
UPSTREAM_TIMEOUT=120s

# Keepalive: lightweight authenticated probe every interval (Go duration).
QUOTA_SYNC_INTERVAL=30m
KEEPALIVE_PING_PATH=/models
# 保活时顺带登录控制台刷新每账号额度快照（纯 HTTP get_stats，无验证码；
# 需账号已配置密码）。关闭：=false
QUOTA_REFRESH_ENABLED=true

# ---------------------------------------------------------------
# 每日签到（08:00 / 20:00 Asia/Shanghai，两处每日额度）
# 领取需要通过 Cloudflare Turnstile 验证。
# ---------------------------------------------------------------
CHECKIN_ENABLED=true

# 控制台基址（登录 + 领取端点所在站点）
PANEL_BASE=https://bailucode.com

# Turnstile 求解器：browser | capsolver | manual
#   browser  — 调 scripts/claim_helper.js：真实浏览器环境自动完成验证。
#              需要：Chrome + Node18+ + puppeteer-core（scripts/ 下 npm i）
#              + Xvfb（无显示器的服务器）。
#   capsolver — 付费 API，适合无浏览器的纯服务器；需 CAPSOLVER_KEY。
#   manual    — 不自动领取，面板仅显示"需人工"。
TURNSTILE_SOLVER=browser
# CAPSOLVER_KEY=CAP-xxxxxxxxxxxxxxxxxxxxxxxx
CHROME_PATH=/usr/bin/google-chrome
CLAIM_HELPER_PATH=./scripts/claim_helper.js

# Per-account concurrency cap for upstream calls.
MAX_INFLIGHT=4
# Max downstream /v1/chat/completions request body bytes.
MAX_REQUEST_BYTES=8388608
